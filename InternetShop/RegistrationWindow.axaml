<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
		MinWidth="600"
		MinHeight="550"
		MaxWidth="600"
		MaxHeight="550"
        x:Class="InternetShop.RegistrationWindow"
		Icon="avares://InternetShop/Assets/logo.ico"
        Title="Смешная регистрация"
        Background="#F8FAFC">
	<StackPanel Orientation="Vertical" VerticalAlignment="Center">
		<TextBlock Text="Регистрация" FontSize="30" HorizontalAlignment="Center"
                  Foreground="#1E293B" FontWeight="Bold" Margin="0,0,0,20"/>
		<StackPanel HorizontalAlignment="Center" Width="350">
			<TextBlock Text="Введите имя пользователя" FontSize="16" Margin="0,10,0,5" Foreground="#1E293B"/>
			<TextBox Name="UsernameBox" Watermark="Имя пользователя"
                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10"
                    Foreground="#1E293B"/>
			<TextBlock Text="Введите пароль" FontSize="16" Margin="0,10,0,5" Foreground="#1E293B"/>
			<TextBox Name="PasswordBox" Watermark="********"
                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10"
                    Foreground="#1E293B"/>
			<TextBlock Text="Введите email" FontSize="16" Margin="0,10,0,5" Foreground="#1E293B"/>
			<TextBox Name="EmailBox" Watermark="example@mail.ru"
                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10"
                    Foreground="#1E293B"/>
			<TextBlock Text="Введите номер телефона" FontSize="16" Margin="0,10,0,5" Foreground="#1E293B"/>
			<TextBox Name="PhoneBox" Watermark="+7-123-456-78-90"
                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10"
                    Foreground="#1E293B"/>
			<TextBlock Text="Введите дату рождения" FontSize="16" Margin="0,10,0,5" Foreground="#1E293B"/>
			<DatePicker Name="BirthdayBox" Margin="0,5,0,15"
                       Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5"/>
			<TextBlock Name="ErrTxt" HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="#DC2626" FontWeight="Medium"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
				<Button Content="Отмена" Click="BackClick" Margin="0,0,15,0"
                       Background="Transparent" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1"
                       CornerRadius="5" Padding="20,10" FontWeight="SemiBold" Cursor="Hand"/>
				<Button Content="Зарегистрироваться" Click="RegistrationClick"
                       Background="#2563EB" Foreground="White" BorderThickness="0"
                       CornerRadius="5" Padding="20,10" FontWeight="SemiBold" Cursor="Hand"/>
			</StackPanel>
		</StackPanel>
	</StackPanel>
</Window>
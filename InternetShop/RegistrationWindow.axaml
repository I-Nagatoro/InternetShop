<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="InternetShop.RegistrationWindow"
        Title="RegistrationWindow">
	<StackPanel Orientation="Vertical" VerticalAlignment="Center">
		<TextBlock Text="Регистрация" FontSize="30" HorizontalAlignment="Center"/>
		<StackPanel HorizontalAlignment="Center">
			<TextBlock Text="Введите имя пользователя" FontSize="18" Margin="0,10,0,0"/>
			<TextBox Name="UsernameBox" Watermark="Имя пользователя" Width="300" HorizontalAlignment="Left" Margin="0,0,0,0"/>
			<TextBlock Text="Введите пароль" FontSize="18" Margin="0,5,0,0"/>
			<TextBox Name="PasswordBox" Watermark="********" Width="300" HorizontalAlignment="Left" Margin="0,0,0,0"/>
			<TextBlock Text="Введите email" FontSize="18" Margin="0,5,0,0"/>
			<TextBox Name="EmailBox" Watermark="example@mail.ru" Width="300" HorizontalAlignment="Left" Margin="0,0,0,0"/>
			<TextBlock Text="Введите номер телефона" FontSize="18" Margin="0,5,0,0"/>
			<TextBox Name="PhoneBox" Watermark="+7-123-456-78-90" Width="300" HorizontalAlignment="Left" Margin="0,0,0,0"/>
			<TextBlock Text="Введите дату рождения" FontSize="18" Margin="0,5,0,0"/>
			<DatePicker Name="BirthdayBox" Margin="0,5,0,0"/>
			<TextBlock Name="ErrTxt" HorizontalAlignment="Center" Foreground="Red"/>
			<StackPanel Orientation="Horizontal">
				<Button Content="Отмена" Click="BackClick" Margin="20,10,12,0"/>
				<Button Content="Зарегистрироваться" Click="RegistrationClick" Margin="10,10,30,0"/>
			</StackPanel>
		</StackPanel>
	</StackPanel>
</Window>

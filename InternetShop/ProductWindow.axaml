<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		MinHeight="550"
		MaxHeight="550"
		MinWidth="800"
		MaxWidth="800"
        x:Class="InternetShop.ProductWindow"
		x:CompileBindings="False"
		Icon="avares://InternetShop/Assets/logo.ico"
        Title="Серьёзное добавление или редактирование продукта"
        Background="#F8FAFC">
	<DockPanel>
		<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
			<TextBlock Text="Добавление/редактирование продукта" FontSize="27"
                      Foreground="#1E293B" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

			<StackPanel Orientation="Horizontal" Spacing="40">
				<StackPanel Orientation="Vertical" Width="400">
					<TextBlock Name="EditTxt" Text="Выберите продукт для редактирования"
							  IsVisible="False" Margin="0,0,0,10" Foreground="#1E293B" FontWeight="Medium"/>

					<ComboBox SelectionChanged="Product_SelectionChanged" Name="ProductBox"
							 Width="400" Margin="0,0,0,15" IsVisible="False"
							 Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10"
							 Foreground="#1E293B"/>

					<TextBlock Text="Введите наименование товара" Margin="0,0,0,5" FontSize="15" Foreground="#1E293B"/>
					<TextBox Name="ProductNameBox" Width="400" HorizontalAlignment="Left" Margin="0,0,0,15"
							Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10"
							Foreground="#1E293B"/>

					<TextBlock Text="Введите описание товара" Margin="0,0,0,5" FontSize="15" Foreground="#1E293B"/>
					<TextBox Name="CaptionBox" Height="100" TextWrapping="Wrap" Margin="0,0,0,15"
							Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10"
							Foreground="#1E293B"/>

					<TextBlock Text="Введите стоимость товара" Margin="0,0,0,5" FontSize="15" Foreground="#1E293B"/>
					<TextBox Name="CostBox" Margin="0,0,0,15" Width="200"
							Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10"
							Foreground="#1E293B" HorizontalAlignment="Left"/>

					<TextBlock Name="ErrTxt" Foreground="#DC2626" FontWeight="Medium"/>
				</StackPanel>

				<StackPanel Orientation="Vertical" Margin="0,25,0,0">
					<Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Background="#FFFFFF" Padding="10">
						<Image Name="ProductImage" Width="200" Height="200" Margin="0,0,0,0"/>
					</Border>
					<Button Click="AddImageClick" Content="Выбрать изображение" Margin="0,10,0,0"
							Background="#1E40AF" Foreground="White" BorderThickness="0"
							CornerRadius="5" Padding="15,8" FontWeight="SemiBold" Width="221"
							HorizontalContentAlignment="Center"/>
				</StackPanel>
			</StackPanel>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" Spacing="15">
				<Button Content="Отмена" Click="BackClick" HorizontalAlignment="Center"
						Background="Transparent" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1"
						CornerRadius="5" Padding="20,10" FontWeight="SemiBold" />

				<Button Content="Создать/Изменить продукт" Click="DoneProductClick"
						Background="#10B981" Foreground="White" BorderThickness="0"
						CornerRadius="5" Padding="20,10" FontWeight="SemiBold"/>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>
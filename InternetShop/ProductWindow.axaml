<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		MinHeight="450"
		MaxHeight="450"
		MinWidth="800"
		MaxWidth="800"
        x:Class="InternetShop.ProductWindow"
        Title="ProductWindow">
	<DockPanel>
		<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
			<TextBlock Text="Добавление/редактирование продукта" FontSize="27"/>
			<StackPanel Orientation="Horizontal">
				<StackPanel Orientation="Vertical">
					<TextBlock Text="Введите наименование товара" Margin="0,20,0,0" FontSize="15"/>
					<TextBox Name="ProductNameBox" Width="400" HorizontalAlignment="Left" Margin="0,5,0,0"/>
					<TextBlock Text="Введите описание товара"  Margin="0,10,0,0" FontSize="15"/>
					<TextBox Name="CaptionBox" Margin="0,5,0,0"/>
					<TextBlock Text="Введите стоимость товара" Margin="0,10,0,0" FontSize="15"/>
					<TextBox Name="CostBox" Margin="0,5,0,0"/>
					<TextBlock Name="ErrTxt" Foreground="Red"/>
				</StackPanel>
				<StackPanel Orientation="Vertical" Margin="40,25,0,0">
					<Image Name="ProductImage" Width="150" Height="150" Source="resm:Avalonia.Skia.Assets.NoiseAsset_256X256_PNG.png?assembly=Avalonia.Skia"/>
					<Button Click="Button_Click" Content="Выбрать изображение" Margin="0,5,0,0"/>
				</StackPanel>
			</StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
				<Button Content="Отмена" HorizontalAlignment="Center"  Margin="0,0,20,0"/>
				<Button Content="Создать продукт" Click="DoneProductClick"/>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>

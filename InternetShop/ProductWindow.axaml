<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		MinHeight="475"
		MaxHeight="475"
		MinWidth="800"
		MaxWidth="800"
        x:Class="InternetShop.ProductWindow"
		x:CompileBindings="False"
        Title="ProductWindow">
	<DockPanel>
		<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
			<TextBlock Text="Добавление/редактирование продукта" FontSize="27"/>
			<StackPanel Orientation="Horizontal">
				<StackPanel Orientation="Vertical">
					<TextBlock Name="EditTxt" Text="Выберите продукт для редактирования" IsVisible="False" Margin="0,20,0,0"/>
					<ComboBox SelectionChanged="Product_SelectionChanged" Name="ProductBox" Width="400" Margin="0,5,0,0" IsVisible="False"/>
					<TextBlock Text="Введите наименование товара" Margin="0,5,0,0" FontSize="15"/>
					<TextBox Name="ProductNameBox" Width="400" HorizontalAlignment="Left" Margin="0,5,0,0"/>
					<TextBlock Text="Введите описание товара"  Margin="0,10,0,0" FontSize="15"/>
					<TextBox Name="CaptionBox" Height="100" TextWrapping="Wrap" Margin="0,5,0,0"/>
					<TextBlock Text="Введите стоимость товара" Margin="0,10,0,0" FontSize="15"/>
					<TextBox Name="CostBox" Margin="0,5,0,0"/>
					<TextBlock Name="ErrTxt" Foreground="Red"/>
				</StackPanel>
				<StackPanel Orientation="Vertical" Margin="40,25,0,0">
					<Border BorderBrush="Black" BorderThickness="1">
						<Image Name="ProductImage" Width="200" Height="200" Margin="0,15,0,0"/>
					</Border>
					<Button Click="AddImageClick" Content="Выбрать изображение" Margin="12,5,0,0"/>
				</StackPanel>
			</StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
				<Button Content="Отмена" Click="BackClick" HorizontalAlignment="Center"  Margin="0,0,20,0"/>
				<Button Content="Создать продукт" Click="DoneProductClick"/>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="427"
		MinHeight="427"
		MaxHeight="427"
		MinWidth="700"
		MaxWidth="700"
		x:CompileBindings="False"
        x:Class="InternetShop.ViewOrderWindow"
        Title="ViewOrderWindow">
	<DockPanel>
		<StackPanel Orientation="Vertical">
			<StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
				<StackPanel Orientation="Vertical">
					<StackPanel Orientation="Horizontal" Margin="15,0,0,0">
						<TextBlock Text="Номер заказа: " Margin="0,15,0,0"/>
						<TextBlock Name="OrderNumber" Margin="0,15,0,0"/>
					</StackPanel>
					<StackPanel Margin="15,0,0,0">
						<TextBlock Name="UserNameTxt" Text="Имя пользователя: " Margin="0,10,0,0"/>
						<TextBlock Text="Номер для связи: " Margin="0,10,0,0"/>
						<TextBox Name="PhoneTxt" Width="300" HorizontalAlignment="Left"/>
						<TextBlock Text="Адрес доставки: " Margin="0,10,0,0"/>
						<TextBox Name="AddressBox" Width="300" Height="100"
								 TextWrapping="Wrap" HorizontalAlignment="Left"/>
						<TextBlock Name="DateOpen" Text="Дата открытия заказа:" Margin="0,10,0,0"/>
						<TextBlock Name="DateClose" Text="Дата закрытия заказа:" Margin="0,10,0,0"/>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="Статус заказа:" Margin="0,17,20,0"/>
							<ComboBox Name="OrderStatus" Width="100" Margin="0,10,0,0">
								<ComboBoxItem>Open</ComboBoxItem>
								<ComboBoxItem>Close</ComboBoxItem>
							</ComboBox>
						</StackPanel>
						<TextBlock Name="CodePickUpTxt" Text="Код для получения заказа: " Margin="0,10,0,0"/>
					</StackPanel>
				</StackPanel>
				<StackPanel Spacing="10" Margin="50,0,0,0">
					<TextBlock Text="Состав заказа:" Margin="0,15,0,0"/>
					<StackPanel  Orientation="Vertical" DockPanel.Dock="Right"
								 VerticalAlignment="Center"
								 HorizontalAlignment="Right">
						<ListBox Name="ProductsList" Height="287" Margin="0,10,0,0">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<StackPanel Orientation="Vertical" Margin="10,0,0,0">
											<TextBlock Text="{Binding ProductName}" FontWeight="Bold"/>
											<TextBlock Text="{Binding Price, StringFormat='Стоимость: {0:C}'}"/>
											<TextBlock Text="{Binding Count, StringFormat='Количество: {0}'}"/>
										</StackPanel>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<TextBlock Name="SumCostTxt" Text="Общая стоимость заказа:" Margin="0,10,0,0"/>
					</StackPanel>
				</StackPanel>
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,15,0,0">
				<Button Click="BackClick" Content="Отмена" Margin="21,0,5,0"/>
				<Button Click="SaveClick" Content="Сохранить изменения" Margin="10,0,5,0"/>
				<Button Click="DeleteProductClick" Content="Удалить выбранный продукт" Margin="10,0,5,0"/>
				<Button Click="DeleteOrderClick" Content="Удалить весь заказ" Margin="10,0,5,0"/>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>
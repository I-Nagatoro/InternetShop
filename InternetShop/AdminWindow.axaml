<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="350"
		MinHeight="350"
		MaxHeight="350"
		MinWidth="600"
		MaxWidth="600"
		Icon="avares://InternetShop/Assets/logo.ico"
        x:Class="InternetShop.AdminWindow"
        Title="Серьёзная панель Админа"
        Background="#F8FAFC">
	<DockPanel>
		<StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
			<TextBlock HorizontalAlignment="Center" Text="Админ панель" FontSize="27"
                      Foreground="#1E293B" FontWeight="Bold" Margin="0,0,0,10"/>

			<Button Click="AddProductClick" Width="315" HorizontalAlignment="Center"
                   Content="Добавить новый продукт" FontSize="15" HorizontalContentAlignment="Center"
                   Background="#1E40AF" Foreground="White" BorderThickness="0"
                   CornerRadius="5" Padding="15,10" FontWeight="SemiBold"/>

			<Button Click="UpdateProductClick" Width="315" HorizontalAlignment="Center"
                   Content="Редактировать существующий продукт" FontSize="15" HorizontalContentAlignment="Center"
                   Background="#1E40AF" Foreground="White" BorderThickness="0"
                   CornerRadius="5" Padding="15,10" FontWeight="SemiBold"/>

			<Button Click="DeleteProductClick" Width="315" HorizontalAlignment="Center"
                   Content="Удалить существующий продукт" FontSize="15" HorizontalContentAlignment="Center"
                   Background="#DC2626" Foreground="White" BorderThickness="0"
                   CornerRadius="5" Padding="15,10" FontWeight="SemiBold"/>

			<Button Click="ShowUpdateOrdersClick" Width="315" HorizontalAlignment="Center"
                   Content="Просмотр и редактирование заказов" FontSize="15" HorizontalContentAlignment="Center"
                   Background="#374151" Foreground="White" BorderThickness="0"
                   CornerRadius="5" Padding="15,10" FontWeight="SemiBold"/>

			<Button Click="ExitClick" Width="100" HorizontalAlignment="Center"
                   Content="Выход" FontSize="15" HorizontalContentAlignment="Center"
                   Background="Transparent" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1"
                   CornerRadius="5" Padding="15,8" FontWeight="SemiBold" Margin="0,10,0,0"/>
		</StackPanel>
	</DockPanel>
</Window>
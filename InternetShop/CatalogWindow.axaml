<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
		Width="900" Height="500"
		MaxHeight="540" MaxWidth="925"
		MinHeight="540" MinWidth="925"
		Icon="avares://InternetShop/Assets/logo.ico"
        x:Class="InternetShop.CatalogWindow"
		x:CompileBindings="False"
        Title="Смешной каталог"
        Background="#F8FAFC">
	<DockPanel>
		<StackPanel Orientation="Vertical">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<TextBlock Text="Каталог" TextAlignment="Center" FontSize="25" Margin="0,10,0,0"
                          Foreground="#1E293B" FontWeight="Bold"/>
				<Button Name="AdmBtn" Content="Админ" Margin="10,10,0,0" Click="AdminClick" IsVisible="False"
                       Background="#6B7280" Foreground="White" BorderThickness="0" CornerRadius="5" Padding="15,8"
                       FontWeight="SemiBold"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
				<TextBox KeyUp="SearchBoxKeyUp" Width="275" Watermark="Поиск" Name="SearchBox"
                        Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10"
                        Foreground="#1E293B"/>
				<ComboBox SelectionChanged="SortAlphComboBox" PlaceholderText="По алфавиту" x:Name="comboSortName" Width="150" Margin="20,0,0,0"
                         Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="5"
                         Foreground="#1E293B">
					<ComboBoxItem VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#1E293B">По возрастанию</ComboBoxItem>
					<ComboBoxItem VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#1E293B">По убыванию</ComboBoxItem>
				</ComboBox>
				<ComboBox VerticalContentAlignment="Center" HorizontalContentAlignment="Center" SelectionChanged="SortCostComboBox" PlaceholderText="По цене" x:Name="comboSortCost" Width="150" Margin="20,0,0,0"
                         Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="5"
                         Foreground="#1E293B">
					<ComboBoxItem VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#1E293B">По возрастанию</ComboBoxItem>
					<ComboBoxItem VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#1E293B">По убыванию</ComboBoxItem>
				</ComboBox>
				<Button VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="DropSortClick" Height="32" Margin="20,0,0,0" Content="Сбросить фильтры"
                       Background="Transparent" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1"
                       CornerRadius="5" Padding="15,0" FontWeight="SemiBold"/>
				<Button VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="32" Margin="20,0,0,0" Content="Корзина" Click="BasketOpen_Click"
                       Background="#10B981" Foreground="White" BorderThickness="0"
                       CornerRadius="5" Padding="15,0" FontWeight="SemiBold"/>
			</StackPanel>
			<ScrollViewer Margin="10">
				<StackPanel Margin="0,10,0,0">
					<ListBox x:Name="CatalogProducts" Height="365" Background="Transparent" BorderThickness="0">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border BorderThickness="1" Padding="10" BorderBrush="#E2E8F0" CornerRadius="8"
                                       Background="#FFFFFF" Margin="0,5">
									<StackPanel Orientation="Horizontal" Spacing="15">
										<Image Width="100" Height="100" Source="{Binding Product.ParseImage}"/>
										<StackPanel>
											<TextBlock Text="{Binding Product.ProductName}" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
											<TextBlock Text="{Binding Product.Cost, StringFormat='Цена: {0:C}'}" FontSize="16" Foreground="#2563EB" FontWeight="SemiBold"/>
											<TextBlock Text="{Binding Product.ProductCaption}" FontSize="14" Foreground="#64748B" Margin="0,0,0,10"/>

											<Button Click="AddToCart" Tag="{Binding Product.ProductId}" Content="Добавить в корзину"
                                                    IsVisible="{Binding !IsInBasket}"
                                                   Background="#2563EB" Foreground="White" BorderThickness="0"
                                                   CornerRadius="5" Padding="15,8" FontWeight="SemiBold"
                                                   HorizontalAlignment="Left"/>

											<StackPanel Orientation="Horizontal" IsVisible="{Binding IsInBasket}" HorizontalAlignment="Left">
												<Button Click="DecreaseQuantity" Tag="{Binding Product.ProductId}" Content="-"
                                                       Background="#E2E8F0" Foreground="#64748B" BorderThickness="0"
                                                       CornerRadius="3" Width="30" Height="30" FontWeight="Bold"/>
												<TextBlock Padding="10" Text="{Binding Quantity}" VerticalAlignment="Center"
                                                          Foreground="#1E293B" FontWeight="SemiBold"/>
												<Button Click="IncreaseQuantity" Tag="{Binding Product.ProductId}" Content="+"
                                                       Background="#2563EB" Foreground="White" BorderThickness="0"
                                                       CornerRadius="3" Width="30" Height="30" FontWeight="Bold"/>
											</StackPanel>
										</StackPanel>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<Button Click="ExitClick" Content="Выйти" Margin="10,10,0,0"
                           Background="Transparent" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1"
                           CornerRadius="5" Padding="15,8" FontWeight="SemiBold" HorizontalAlignment="Left"/>
				</StackPanel>
			</ScrollViewer>
		</StackPanel>
	</DockPanel>
</Window>
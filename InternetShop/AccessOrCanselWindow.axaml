<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="150"
		MinHeight="150"
		MaxHeight="150"
		MinWidth="250"
		MaxWidth="250"
        x:Class="InternetShop.AccessOrCanselWindow"
		Icon="avares://InternetShop/Assets/logo.ico"
        Title="Страшное подтверждение"
		WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
	<DockPanel>
		<StackPanel Orientation="Vertical"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Spacing="15">
			<TextBlock Text="Вы точно уверены?" FontSize="18" HorizontalAlignment="Center"
                      Foreground="#1E293B" FontWeight="SemiBold"/>
			<StackPanel Orientation="Horizontal" Spacing="10">
				<Button Content="Отмена" Width="80"
						Click="CancelClick"
						Background="Transparent" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1"
						CornerRadius="5" Padding="10,8" FontWeight="SemiBold"/>

				<Button Content="Да" Width="80"
						HorizontalContentAlignment="Center"
						Click="OkClick"
						Background="#DC2626" Foreground="White" BorderThickness="0"
						CornerRadius="5" Padding="10,8" FontWeight="SemiBold"/>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
		Width="400" Height="150"
        x:Class="InternetShop.ErrorWindow"
		Icon="avares://InternetShop/Assets/logo.ico"
        Title="Серьёзное уведомление">
	<StackPanel Orientation="Vertical" VerticalAlignment="Center">
		<TextBlock x:Name="errorMsg" HorizontalAlignment="Center" TextWrapping="Wrap" Padding="10"/>
	    <Button Content="ОК" Click="CloseClick" HorizontalAlignment="Center"/>
	</StackPanel>
</Window>

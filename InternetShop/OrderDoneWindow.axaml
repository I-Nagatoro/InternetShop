<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
		MaxHeight="150" MaxWidth="300" MinHeight="150" MinWidth="300"
        x:Class="InternetShop.OrderDoneWindow"
        Title="OrderDoneWindow">
	<Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*">
		<TextBlock VerticalAlignment="Bottom" Grid.Row="1" Grid.ColumnSpan="2" Text="Заказ успешно оформлен!" HorizontalAlignment="Center"/>
		<TextBlock Name="CodeTxt" VerticalAlignment="Top" Grid.Row="2" Grid.ColumnSpan="2" Text="Код для получения заказа: " HorizontalAlignment="Center"/>
	</Grid>

</Window>

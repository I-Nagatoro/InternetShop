<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
		MaxHeight="150" MaxWidth="300" MinHeight="250" MinWidth="400"
        x:Class="InternetShop.OrderDoneWindow"
        Title="Смешной заказ оформлен"
		Icon="avares://InternetShop/Assets/logo.ico"
        Background="#F0FDF4"
        WindowStartupLocation="CenterOwner">
	<Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*" Margin="20">
		<TextBlock VerticalAlignment="Bottom" Grid.Row="0" Grid.ColumnSpan="2"
                  Text="Заказ успешно оформлен!" HorizontalAlignment="Center"
                  Foreground="#065F46" FontSize="16" FontWeight="SemiBold"/>

		<TextBlock Name="CodeTxt" VerticalAlignment="Top" Grid.Row="1" Grid.ColumnSpan="2"
                  Text="Код для получения заказа: " HorizontalAlignment="Center"
                  Foreground="#047857" FontSize="14" FontWeight="Medium" Margin="0,10,0,0"/>

		<Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalContentAlignment="Center" Content="OK" HorizontalAlignment="Center"
               VerticalAlignment="Center" Margin="0,15,0,0" Width="80"
               Background="#10B981" Foreground="White" BorderThickness="0"
               CornerRadius="5" Padding="10,5" FontWeight="SemiBold" 
			   Click="CloseClick"/>
	</Grid>
</Window>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="510"
		MaxHeight="510" MaxWidth="800"
		MinHeight="510" MinWidth="800"
		SizeToContent="WidthAndHeight"
		Icon="avares://InternetShop/Assets/logo.ico"
        x:Class="InternetShop.MainWindow"
        Title="Добро пожаловать!"
        Background="#F8FAFC">
	<DockPanel>
		<StackPanel>
			<StackPanel Orientation="Vertical" DockPanel.Dock="Top">
				<TextBlock TextAlignment="Center" FontSize="25" Margin="0,20,0,70" Text='Добро пожаловать в Интернет Магазин "Смешные Цены" '
                          Foreground="#1E293B" FontWeight="SemiBold"/>
			</StackPanel>
			<StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
				<TextBlock Text="Войдите в аккаунт" FontSize="20" Padding="20" Foreground="#1E293B" FontWeight="Medium"/>
			</StackPanel>
			<StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
				<TextBlock Text="Введите имя" Foreground="#64748B" Margin="0,0,0,5"/>
				<TextBox x:Name="usernameBox" Margin="0,0,0,15"
                        Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10"
                        Foreground="#1E293B"/>
				<TextBlock Text="Введите пароль" Foreground="#64748B" Margin="0,0,0,5"/>
				<TextBox x:Name="passwordBox"
                        Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10"
                        Foreground="#1E293B"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,80,0,0" HorizontalAlignment="Center">
				<Button Click="RegistrationOpen" Content="Регистрация" Margin="0,0,25,0"
                       Background="Transparent" Foreground="#2563EB" BorderBrush="#2563EB" BorderThickness="1"
                       CornerRadius="5" Padding="20,10" FontWeight="SemiBold" Cursor="Hand"/>
				<Button Content="Войти" x:Name="Enter" Click="EnterButton"
                       Background="#2563EB" Foreground="White" BorderThickness="0"
                       CornerRadius="5" Padding="20,10" FontWeight="SemiBold" Cursor="Hand"/>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>
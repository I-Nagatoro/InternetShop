<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="InternetShop.DeleteProductWindow"
        Title="DeleteProductWindow">
	<DockPanel>
		<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
			<TextBlock Text="Выберите продукт для удаления из базы" 
					   TextWrapping="Wrap"
					   FontSize="15"
					   Width="500"
					   Margin="0,0,0,0"/>
			<ComboBox Width="400"
					  Margin="0,10,0,10"
					  Name="ProductCombo"/>
			<TextBlock Text="Внимание при удалении данный продукт пропадёт из всех корзин и заказов пользователей! Будьте аккуратны!"
					   Foreground="Red"
					   TextWrapping="Wrap"
					   FontSize="15"
					   Width="500"/>
			<StackPanel Orientation="Horizontal">
				<Button Content="Назад" 
						Margin="0,10,10,0"
						Click="BackClick"/>
				<Button Content="Удалить продукт" 
						Margin="0,10,0,0"
						Click="DeleteClick"/>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>

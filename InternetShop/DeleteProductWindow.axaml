<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
		Width="600"
		Height="400"
        x:Class="InternetShop.DeleteProductWindow"
		Icon="avares://InternetShop/Assets/logo.ico"
        Title="Страшное удаление продукта"
        Background="#F8FAFC">
	<DockPanel>
		<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
			<TextBlock Text="Выберите продукт для удаления из базы"
					   TextWrapping="Wrap"
					   FontSize="18"
					   Foreground="#1E293B"
					   FontWeight="SemiBold"
					   HorizontalAlignment="Center"
					   Margin="0,0,0,15"/>

			<Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,20">
				<TextBlock Text="Внимание! При удалении данный продукт пропадёт из всех корзин и заказов пользователей! Будьте внимательны и осторожны!"
					   Foreground="#DC2626"
					   TextWrapping="Wrap"
					   FontSize="14"
					   FontWeight="Medium"
					   HorizontalAlignment="Center"/>
			</Border>

			<ComboBox Width="400"
					  Margin="0,10,0,20"
					  Name="ProductCombo"
					  Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="10"
					  Foreground="#1E293B"
					  HorizontalAlignment="Center"/>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
				<Button Content="Назад"
						Margin="0,10,0,0"
						Click="BackClick"
						Background="Transparent" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1"
						CornerRadius="5" Padding="20,10" FontWeight="SemiBold" Width="120" HorizontalContentAlignment="Center"/>

				<Button Content="Удалить продукт"
						Margin="0,10,0,0"
						Click="DeleteClick"
						Background="#DC2626" Foreground="White" BorderThickness="0"
						CornerRadius="5" Padding="20,10" FontWeight="SemiBold" Width="160" HorizontalContentAlignment="Center"/>
			</StackPanel>
		</StackPanel>
	</DockPanel>
</Window>